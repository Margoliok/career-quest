# OpenAI кілті (болмаса жүйе офлайн режимде жұмыс істейді)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# auto | openai | offline
LLM_MODE=auto
# JWT құпия кілті (өндірісте міндетті түрде өзгертіңіз, кемінде 32 таңба)
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min
# Жергілікті іске қосу (docker-compose ішінде DATABASE_URL автоматты беріледі)
DATABASE_URL=postgresql+psycopg://careerquest:careerquest@localhost:5433/careerquest
